#. Translators: compact duration — s = seconds.
#: lib/countdown.js:9
#, javascript-format
msgid "%ds"
msgstr "%ds"

#. Translators: compact duration — m = minutes.
#: lib/countdown.js:13
#, javascript-format
msgid "%dm"
msgstr "%dm"

#. Translators: compact duration — h = hours, m = minutes.
#: lib/countdown.js:15
#, javascript-format
msgid "%dh %dm"
msgstr "%dh %dm"

#: lib/countdown.js:24
msgid "now"
msgstr "maintenant"

#. Translators: compact countdown — d = days, h = hours.
#: lib/countdown.js:32
#, javascript-format
msgid "%dd %dh"
msgstr "%dj %dh"

#. Translators: compact countdown — h = hours, m = minutes (zero-padded).
#: lib/countdown.js:34
#, javascript-format
msgid "%dh %02dm"
msgstr "%dh %02dm"

#: lib/countdown.js:59
msgid "Reset due"
msgstr "Réinitialisation imminente"

#. Translators: "Resets in 4h 05m · 13:54" — a countdown, then the clock time (or date and time).
#: lib/countdown.js:61
#, javascript-format
msgid "Resets in %s · %s"
msgstr "Réinitialisé dans %s · %s"

#: lib/format.js:103
#, javascript-format
msgid "%d reset available"
msgid_plural "%d resets available"
msgstr[0] "%d réinitialisation disponible"
msgstr[1] "%d réinitialisations disponibles"

#. Translators: "Claude — Session at 97%": the vendor, the usage window, then the percentage.
#: lib/notify.js:48
#, javascript-format
msgid "%s — %s at %d%%"
msgstr "%s — %s à %d%%"

#: lib/notify.js:49
#, javascript-format
msgid "%d%% of the %s used"
msgstr "%d%% de %s utilisé"

#. Translators: appended to the body — " · resets 2h 05m (16:00)".
#: lib/notify.js:52
#, javascript-format
msgid " · resets %s (%s)"
msgstr " · réinitialisation dans %s (%s)"

#. Translators: "Claude — reset credit expires Oct 22 16:00".
#: lib/notify.js:59
#, javascript-format
msgid "%s — reset credit expires %s"
msgstr "%s — le crédit de réinitialisation expire le %s"

#. Translators: "Full reset — redeem within 1d 4h (16:00)".
#: lib/notify.js:61
#, javascript-format
msgid "%s — redeem within %s (%s)"
msgstr "%s — à utiliser dans %s (%s)"

#: lib/notify.js:61 lib/vendors/openai/section.js:32
msgid "Reset credit"
msgstr "Crédit de réinitialisation"

