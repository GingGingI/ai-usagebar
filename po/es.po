msgstr ""
"HTTP %d: autenticación rechazada — las credenciales pueden faltar, haber "
"caducado o ser inválidas"

#: lib/vendors/section-common.js:76
#, javascript-format
msgid "HTTP %s"
msgstr "HTTP %s"

#: lib/vendors/section-common.js:87
#, javascript-format
