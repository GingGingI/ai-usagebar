msgid "General"
msgstr "General"

#: prefs.js:56
msgid "Display"
msgstr "Visualización"

#: prefs.js:62
msgid "Primary vendor"
msgstr "Proveedor principal"

#: prefs.js:63
msgid "Shown by default and used as the scroll-cycle reset target"
msgstr ""
"Se muestra de forma predeterminada y se usa como destino de reinicio al "
"desplazar"

#: prefs.js:87
msgid "Refresh"
msgstr "Actualización"

#. Translators: %d is the minimum refresh interval in seconds.
#: prefs.js:89
#, javascript-format
msgid "Minimum %d s — the upstream endpoints rate-limit below that."
msgstr ""
"Mínimo %d s — los endpoints upstream limitan la tasa por debajo de eso."

#: prefs.js:98
msgid "Refresh interval (seconds)"
msgstr "Intervalo de actualización (segundos)"

#: prefs.js:121
msgid "Panel label"
msgstr "Etiqueta del panel"

#. Translators: the {token} names are literal placeholders the user
#. types — keep them verbatim, only translate the surrounding prose.
#: prefs.js:124
msgid ""
"Placeholders: {vendor_short} {session_pct}% {session_reset} {plan} "
"{weekly_pct} {weekly_reset}"
msgstr ""
"Marcadores: {vendor_short} {session_pct}% {session_reset} {plan} "
"{weekly_pct} {weekly_reset}"

#: prefs.js:126
msgid "Bar format"
msgstr "Formato de la barra"

#: prefs.js:132
msgid "Popup"
msgstr "Ventana emergente"

#. Translators: the {token} names are literal placeholders the user
#. types — keep them verbatim, only translate the surrounding prose.
#: prefs.js:135
msgid ""
"Optional extra lines shown above the popup. Empty uses the built-in layout. "
"Placeholders: {plan} {session_pct} {session_reset} {weekly_pct} "
"{weekly_reset}"
msgstr ""
"Líneas extra opcionales mostradas sobre la ventana emergente. Vacío usa el "
"diseño interno. Marcadores: {plan} {session_pct} {session_reset} "
"{weekly_pct} {weekly_reset}"

#: prefs.js:137
msgid "Popup format"
msgstr "Formato de la ventana emergente"

#: prefs.js:138
msgid "Show pace marker"
msgstr "Mostrar marcador de ritmo"

#: prefs.js:142
msgid "Severity colors"
msgstr "Colores de severidad"

#: prefs.js:143
msgid ""
"Pick a color per severity tier. Reset returns a tier to its built-in default."
msgstr ""
"Elige un color para cada nivel de severidad. Restablecer devuelve el nivel a "
"su valor predeterminado."

#. Translators: Low/Mid/High/Critical are usage-severity tier names.
#: prefs.js:147
msgid "Low"
msgstr "Bajo"

#: prefs.js:148
msgid "Mid"
msgstr "Medio"

#: prefs.js:149
msgid "High"
msgstr "Alto"

#: prefs.js:150
msgid "Critical"
msgstr "Crítico"

#: prefs.js:154
msgid "Notifications"
msgstr "Notificaciones"

#: prefs.js:155
msgid ""
"Show a desktop notification the first time a vendor reaches the threshold. "
"It re-arms when usage drops back or the window resets."
msgstr ""
"Muestra una notificación la primera vez que un proveedor alcanza el umbral. "
"Se rearma cuando el uso baja o la ventana se reinicia."

#: prefs.js:157
msgid "Notify on high usage"
msgstr "Notificar con uso elevado"

#: prefs.js:165
msgid "Notification threshold (%)"
msgstr "Umbral de notificación (%)"

#: prefs.js:188 prefs.js:227
msgid "Reset"
msgstr "Restablecer"

#: prefs.js:189
msgid ""
"Restore every setting — vendor toggles, paths, keys, formats, and colors — "
"to its built-in default."
msgstr ""
"Restablece cada ajuste — interruptores de proveedores, rutas, claves, "
"formatos y colores — a su valor predeterminado."

#: prefs.js:191
msgid "Reset all settings"
msgstr "Restablecer todos los ajustes"

#: prefs.js:223
msgid "Reset all settings?"
msgstr "¿Restablecer todos los ajustes?"

#: prefs.js:224
msgid ""
"This restores every setting to its built-in default and cannot be undone."
msgstr ""
"Esto restablece cada ajuste a su valor predeterminado y no se puede deshacer."

#: prefs.js:226
msgid "Cancel"
msgstr "Cancelar"

