#. Translators: compact duration — s = seconds.
#: lib/countdown.js:9
#, javascript-format
msgid "%ds"
msgstr "%ds"

#. Translators: compact duration — m = minutes.
#: lib/countdown.js:13
#, javascript-format
msgid "%dm"
msgstr "%dm"

#. Translators: compact duration — h = hours, m = minutes.
#: lib/countdown.js:15
#, javascript-format
msgid "%dh %dm"
msgstr "%dh %dm"

#: lib/countdown.js:24
msgid "now"
msgstr "agora"

#. Translators: compact countdown — d = days, h = hours.
#: lib/countdown.js:32
#, javascript-format
msgid "%dd %dh"
msgstr "%dd %dh"

#. Translators: compact countdown — h = hours, m = minutes (zero-padded).
#: lib/countdown.js:34
#, javascript-format
msgid "%dh %02dm"
msgstr "%dh %02dm"

#: lib/countdown.js:55
msgid "Reset due"
msgstr "Reinício pendente"

#. Translators: "Resets in 4h 05m · 13:54" — a countdown, then the clock time (or date and time).
#: lib/countdown.js:57
#, javascript-format
msgid "Resets in %s · %s"
msgstr "Reinicia em %s · %s"

#: lib/notify.js:47
msgid "Usage is critical"
msgstr "Uso crítico"

#: lib/notify.js:48
#, javascript-format
msgid "Usage at %d%%"
msgstr "Uso em %d%%"

