msgstr ""
"HTTP %d: autenticação rejeitada — as credenciais podem estar ausentes, "
"expiradas ou inválidas"

#: lib/vendors/section-common.js:76
#, javascript-format
msgid "HTTP %s"
msgstr "HTTP %s"

#: lib/vendors/section-common.js:87
#, javascript-format
